{
  "name": "smartbank-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --port 4200",
    "build": "ng build --configuration=production",
    "test": "vitest run",
    "test:core": "vitest run src/app/core/currency.spec.ts src/app/core/iban.spec.ts",
    "test:interceptors": "vitest run src/app/core/interceptors/auth.interceptor.spec.ts src/app/core/interceptors/error.interceptor.spec.ts",
    "test:auth": "vitest run src/app/features/auth/auth.store.spec.ts src/app/features/auth/auth.guard.spec.ts",
    "test:accounts": "vitest run src/app/features/accounts/data-access/ledger.service.spec.ts src/app/features/accounts/account-detail.page.spec.ts",
    "test:transfers": "vitest run src/app/features/transfers/transfer.page.spec.ts",
    "test:cards": "vitest run src/app/features/cards/cards.page.spec.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@angular/animations": "20.0.0",
    "@angular/common": "20.0.0",
    "@angular/compiler": "20.0.0",
    "@angular/core": "20.0.0",
    "@angular/forms": "20.0.0",
    "@angular/platform-browser": "20.0.0",
    "@angular/router": "20.0.0",
    "@lucide/angular": "^1.47.0",
    "lucide-angular": "^1.0.0",
    "rxjs": "7.8.1",
    "tslib": "2.8.1",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular/build": "20.0.0",
    "@angular/cli": "20.0.0",
    "@angular/compiler-cli": "20.0.0",
    "@playwright/test": "1.50.0",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vitest": "3.2.7"
  }
}
